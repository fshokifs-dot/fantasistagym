  let el = null, x0 = 0, y0 = 0, base = 0, w = 0, moving = false, decided = false, pid = null;
  document.addEventListener('pointerdown', e => {
    const f = e.target.closest ? e.target.closest('.sw-front') : null;
    if (SW_OPEN && SW_OPEN !== f) { swClose(SW_OPEN); }
    if (!f) return;
    el = f; x0 = e.clientX; y0 = e.clientY; w = Number(f.getAttribute('data-w')) || SW_W * 2;
    base = (SW_OPEN === f) ? -w : 0; moving = false; decided = false; pid = e.pointerId;
  });
  document.addEventListener('pointermove', e => {
    if (!el || e.pointerId !== pid) return;
    const dx = e.clientX - x0, dy = e.clientY - y0;
    if (!decided) {
