/* ---------- 予定（日・週のカレンダー） ---------- */
let PENDING = '', ITEMS = {}, SEL = null, PK_DATE = '', LAST_TRAINER = '', BUSY = false, TL_START = 9;
let MODE = 'week';
try { MODE = localStorage.getItem('schedMode') || 'week'; } catch (e) {}
const HP = 64, WHP = 64;   // 1時間あたりの高さ（日の表示・週の表示）
const BLK = 15;            // 同時人数を数える細かさ（分）
const WK = '日月火水木金土';
// 担当ごとの色（トレーナーシートの順番で決まる）
const PAL = ['#1E5AA8', '#E0861A', '#0B8043', '#8E24AA', '#039BE5', '#C2185B', '#3F51B5', '#33B679', '#795548', '#616161'];
const NOTR = '#a39e93';

function pad2(n) { return String(n).padStart(2, '0'); }
function toMin(t) { const p = String(t).split(':'); return Number(p[0]) * 60 + Number(p[1] || 0); }
function minStr(m) { return pad2(Math.floor(m / 60)) + ':' + pad2(m % 60); }
function ymdOf(s) { const p = String(s).split('/'); return new Date(+p[0], +p[1] - 1, +p[2]); }
function fmtD(d) { return d.getFullYear() + '/' + pad2(d.getMonth() + 1) + '/' + pad2(d.getDate()); }
function addD(s, n) { const d = ymdOf(s); d.setDate(d.getDate() + n); return fmtD(d); }
function sDate() { return v('s-date').replace(/-/g, '/'); }
function setSDate(s) { $('s-date').value = s.replace(/\//g, '-'); }
function todayStr() { return fmtD(new Date()); }
function weekStart(s) { const d = ymdOf(s); d.setDate(d.getDate() - d.getDay()); return fmtD(d); }
function weekDays() { const st = weekStart(sDate()); return [0, 1, 2, 3, 4, 5, 6].map(i => addD(st, i)); }
function dateLabel(s) { const d = ymdOf(s); return (d.getMonth() + 1) + '/' + d.getDate() + '(' + WK[d.getDay()] + ')'; }
function rangeLabel(a, b) {
  const x = ymdOf(a), y = ymdOf(b);
  return (x.getMonth() + 1) + '月' + x.getDate() + '日〜' + (x.getMonth() === y.getMonth() ? '' : (y.getMonth() + 1) + '月') + y.getDate() + '日';
}

function setMode(m) { MODE = m; try { localStorage.setItem('schedMode', m); } catch (e) {} loadSched(); }
function shiftDay(n) { setSDate(addD(sDate(), MODE === 'week' ? n * 7 : n)); loadSched(); }
function goToday() { setSDate(todayStr()); loadSched(); }
function openDay(d) { setSDate(d); setMode('day'); }

function loadSched() {
  const d = sDate();
  if (!d || !KEY) return;
  if (MODE === 'week') {
    const first = weekDays()[0];
    srv('getWeek', [first], r => {
      r.days.forEach(x => { ITEMS[x] = []; });
      r.items.forEach(it => { (ITEMS[it.date] = ITEMS[it.date] || []).push(it); });
      if (MODE === 'week' && weekStart(sDate()) === r.days[0]) renderSched();
    });
  } else {
    srv('getSchedule', [d], l => { ITEMS[d] = l; if (MODE === 'day' && d === sDate()) renderSched(); });
  }
  renderSched();  // 手元にあるデータで先に描いておく
}

function itemsOn(date) { return ITEMS[date] || []; }
function shown(date) {
  const f = v('sf-trainer');
  return itemsOn(date).filter(b => !f || (f === '__none' ? !b.trainer : b.trainer === f));
}
// 同時に何人入っているか（15分ごと）。担当の絞り込みに関係なく全員分で数える
function conc(date, b0) {
  return itemsOn(date).filter(b => toMin(b.time) < b0 + BLK && toMin(b.time) + (b.dur || 60) > b0).length;
}
// その1時間（h時台）でいちばん混んでいるときの人数
function hourCount(date, h) {
  let m = 0;
  for (let b = h * 60; b < (h + 1) * 60; b += BLK) m = Math.max(m, conc(date, b));
  return m;
}
function colorOf(b) {
  const i = (b.trainer && D) ? D.trainers.indexOf(b.trainer) : -1;
  return i < 0 ? NOTR : PAL[i % PAL.length];
}
function hourRange(dates) {
  let sH = OPEN, eH = CLOSE;
  dates.forEach(d => itemsOn(d).forEach(b => {
    const st = toMin(b.time);
    sH = Math.min(sH, Math.floor(st / 60));
    eH = Math.max(eH, Math.ceil((st + (b.dur || 60)) / 60));
  }));
  return [sH, Math.min(eH, 24)];
}
function layoutItems(items) {
  const out = [];
  let cluster = [], clusterEnd = 0;
  function flush() {
    const cols = Math.max.apply(null, cluster.map(x => x.col + 1));
    cluster.forEach(x => { x.cols = cols; out.push(x); });
    cluster = [];
  }
  items.forEach(it => {
    if (cluster.length && it.start >= clusterEnd) flush();
    const taken = cluster.filter(x => x.end > it.start).map(x => x.col);
    let col = 0;
    while (taken.indexOf(col) >= 0) col++;
    it.col = col;
    cluster.push(it);
    clusterEnd = Math.max(clusterEnd, it.end);
  });
  if (cluster.length) flush();
  return out;
}
function placed(date) {
  return layoutItems(shown(date)
    .map(b => ({ b: b, start: toMin(b.time), end: toMin(b.time) + (b.dur || 60) }))
    .sort((x, y) => x.start - y.start || x.end - y.end));
}
function blockHtml(date, it, top, ht, week) {
  const b = it.b, w = 100 / it.cols;
  const pos = 'top:' + top + 'px;height:' + ht + 'px;left:calc(' + (it.col * w) + '% + 1px);width:calc(' + w + '% - 2px);';
  const vert = week && it.cols >= 2;
  // 細いときは名前を1文字ずつ縦に並べる
  let inner = vert
    ? '<b>' + ((b.done ? '✓' : '') + String(b.member).replace(/[\s\u3000]/g, '')).split('').map(esc).join('<br>') + '</b>'
    : '<b>' + (b.done ? '✓' : '') + esc(b.member) + '</b>';
  if (!vert) {
    if (week) inner += '<br>' + esc(b.trainer || '');
    else inner += (b.menu ? '<span class="tag">' + esc(b.menu) + '</span>' : '') + (b.src === 'Web' ? '<span class="tag">Web</span>' : '') + '<br><span class="t">' + minStr(it.start) + '–' + minStr(it.end) + '</span>　' + esc(b.trainer || '担当未定');
  }
  return '<div class="blk' + (b.done ? ' done' : '') + (vert ? ' v' : '') + '" onclick="event.stopPropagation();openSheet(\'' + date + '\',\'' + esc(b.id) + '\')" style="' + pos + 'background:' + colorOf(b) + '">' + inner + '</div>';
}

function renderLegend() {
  if (!D) return;
  $('legend').innerHTML = D.trainers.map((t, i) => '<span><i style="background:' + PAL[i % PAL.length] + '"></i>' + esc(t) + '</span>').join('') +
    '<span><i style="background:' + NOTR + '"></i>担当未定</span><span><i style="background:#F7D3D5"></i>満員の時間</span>';
}

function renderSched() {
  $('m-day').classList[MODE === 'day' ? 'add' : 'remove']('on');
  $('m-week').classList[MODE === 'week' ? 'add' : 'remove']('on');
  renderLegend();
  if (MODE === 'week') renderWeek(); else renderDay();
}

function renderDay() {
  const date = sDate();
  const list = shown(date);
  const f = v('sf-trainer');
  $('s-range').textContent = dateLabel(date) + (date === todayStr() ? '　今日' : '');
  $('s-count').textContent = list.length + '件' + (f ? '（' + (f === '__none' ? '担当未定' : f) + '）' : '');
  const r = hourRange([date]), sH = r[0], eH = r[1];
  TL_START = sH;
  let html = '<div class="tl" onclick="tlClick(event,this)" style="height:' + ((eH - sH) * HP) + 'px">';
  for (let h = sH; h <= eH; h++) {
    const y = (h - sH) * HP;
    let label = h + ':00';
    if (h < eH) {
      const c = hourCount(date, h);
      label += '<br><span class="cnt' + (c >= CAP ? ' full' : '') + '">' + (c >= CAP ? '満 ' : '') + c + '/' + CAP + '</span>';
      if (c >= CAP) html += '<div class="fullbg" style="top:' + y + 'px;height:' + HP + 'px"></div>';
      else html += '<div class="slot" style="top:' + y + 'px;height:' + HP + 'px">＋ あと' + (CAP - c) + '枠</div>';
      html += '<div class="half" style="top:' + (y + HP / 2) + 'px"></div>';
    }
    html += '<div class="line" style="top:' + y + 'px"></div><div class="hr" style="top:' + y + 'px">' + label + '</div>';
  }
  placed(date).forEach(it => {
    html += blockHtml(date, it, (it.start - sH * 60) * HP / 60, Math.max(36, (it.end - it.start) * HP / 60 - 2), false);
  });
  $('s-list').innerHTML = html + '</div>';
}

function renderWeek() {
  const days = weekDays(), today = todayStr();
  const r = hourRange(days), sH = r[0], eH = r[1];
  TL_START = sH;
  $('s-range').textContent = rangeLabel(days[0], days[6]);
  $('s-count').textContent = days.reduce((n, d) => n + shown(d).length, 0) + '件';
  let h = '<div class="wk"><div class="wk-head"><div class="wk-gut"></div>' + days.map(d => {
    const w = ymdOf(d).getDay();
    return '<div class="wd' + (w === 0 ? ' sun' : w === 6 ? ' sat' : '') + (d === today ? ' today' : '') + '" onclick="openDay(\'' + d + '\')"><span>' + WK[w] + '</span><b>' + ymdOf(d).getDate() + '</b></div>';
  }).join('') + '</div>';
  h += '<div class="wk-body" style="height:' + ((eH - sH) * WHP) + 'px">';
  for (let x = sH; x <= eH; x++) {
    const y = (x - sH) * WHP;
    h += '<div class="wk-line" style="top:' + y + 'px"></div><div class="wk-hr" style="top:' + y + 'px">' + x + ':00</div>';
  }
  h += '<div class="wk-cols" onclick="wkClick(event,this)">';
  days.forEach((d, di) => {
    h += '<div class="wk-col" style="left:' + (di * 100 / 7) + '%;width:' + (100 / 7) + '%">';
    for (let x = sH; x < eH; x++) {
      const top = (x - sH) * WHP;
      if (hourCount(d, x) >= CAP) h += '<div class="fullbg" style="top:' + top + 'px;height:' + WHP + 'px"></div>';
      else if (d >= today) h += '<div class="slot" style="top:' + top + 'px;height:' + WHP + 'px">＋</div>';
    }
    placed(d).forEach(it => {
      h += blockHtml(d, it, (it.start - sH * 60) * WHP / 60, Math.max(18, (it.end - it.start) * WHP / 60 - 1), true);
    });
    h += '</div>';
  });
  $('s-list').innerHTML = h + '</div></div></div>';
}

function tlClick(ev, el) {
  const y = ev.clientY - el.getBoundingClientRect().top;
  const m = TL_START * 60 + Math.max(0, Math.floor(y / (HP / 2))) * 30;
  openPicker(Math.min(m, 23 * 60 + 30), sDate());
}
function wkClick(ev, el) {
  const rc = el.getBoundingClientRect();
  const di = Math.min(6, Math.max(0, Math.floor((ev.clientX - rc.left) / (rc.width / 7))));
  const m = TL_START * 60 + Math.max(0, Math.floor((ev.clientY - rc.top) / (WHP / 2))) * 30;
  openPicker(Math.min(m, 23 * 60 + 30), weekDays()[di]);
}
function defaultStart(date) {
  const now = new Date();
  if (date === todayStr()) {
    const m = Math.ceil((now.getHours() * 60 + now.getMinutes()) / 30) * 30;
    if (m >= OPEN * 60 && m < CLOSE * 60) return m;
  }
  return OPEN * 60;
}

/* 下から出るパネル */
function showPanel(id) {
  ['sheet', 'picker'].forEach(x => $(x).style.display = (x === id ? 'block' : 'none'));
  $('dim').style.display = id ? 'block' : 'none';
}
function closeAll() { showPanel(''); }

/* 会員を選んで追加 */
function openPicker(min, date) {
  PK_DATE = date || sDate();
  $('pk-time').value = minStr(min);
  $('pk-q').value = '';
  $('pk-new').value = '';
  const f = v('sf-trainer');
  $('pk-trainer').value = (f && f !== '__none') ? f : LAST_TRAINER;
  pickerHead();
  renderPicker();
  showPanel('picker');
  $('picker').scrollTop = 0;
}
// 入れようとしている時間のうち、もう満員の時間帯（時）
function fullHours(date, st, dur) {
  const out = [];
  for (let b = Math.floor(st / BLK) * BLK; b < st + dur; b += BLK) {
    const h = Math.floor(b / 60);
    if (conc(date, b) >= CAP && out.indexOf(h) < 0) out.push(h);
  }
  return out;
}
function pickerHead() {
  const t = v('pk-time');
  $('pk-title').textContent = dateLabel(PK_DATE) + ' ' + (t || '') + '〜';
  if (!t) { $('pk-cap').textContent = ''; return; }
  const st = toMin(t), dur = Number(v('pk-dur')) || 60;
  const parts = [];
  for (let h = Math.floor(st / 60); h * 60 < st + dur; h++) parts.push(h + '時台 ' + hourCount(PK_DATE, h) + '/' + CAP + '人');
  const full = fullHours(PK_DATE, st, dur);
  $('pk-cap').textContent = '予約の埋まり具合：' + parts.join('、') + (full.length ? '（満枠あり）' : '');
  $('pk-cap').className = 'capline' + (full.length ? ' full' : '');
}
function renderPicker() {
  if (!D) return;
  const q = norm(v('pk-q'));
  const list = D.members.map((m, i) => ({ m: m, i: i })).filter(x => !q || norm(x.m.name).indexOf(q) >= 0);
  $('pk-list').innerHTML = list.map(x =>
    '<button class="pk-item" onclick="pickMember(' + x.i + ')"><span><b>' + esc(x.m.name) + '</b> <span class="sub">' + esc(x.m.plan || '') + '</span></span>' +
    '<span class="sub' + (x.m.left <= 1 ? ' low' : '') + '">残り' + x.m.left + '回</span></button>'
  ).join('') || '<div class="sub" style="padding:14px">' + (q ? '見つかりません。下の欄で体験・新規として追加できます' : '会員がまだいません') + '</div>';
}
function pickMember(i) { addFromPicker(D.members[i].name, false); }
function pickNew() {
  const n = v('pk-new');
  if (!n) return toast('お名前を入れてね');
  addFromPicker(n, true);
}
function addFromPicker(name, isNew) {
  if (BUSY) return;
  const t = v('pk-time');
  if (!t) return toast('開始時間を入れてね');
  const date = PK_DATE, st = toMin(t), dur = Number(v('pk-dur')) || 60;
  const full = fullHours(date, st, dur);
  if (full.length && !confirm(full.map(h => h + '時台').join('・') + 'は、もう' + CAP + '枠埋まっています。それでも追加しますか？')) return;
  LAST_TRAINER = v('pk-trainer');
  BUSY = true;
  srv('addBooking', [{ date: date, time: t, member: name, trainer: LAST_TRAINER, memo: isNew ? '体験・新規' : '', dur: dur, menu: v('pk-menu') }],
    l => { BUSY = false; ITEMS[date] = l; renderSched(); closeAll(); toast(name + 'さんを ' + dateLabel(date) + ' ' + t + ' に入れました'); },
    (e, h) => { BUSY = false; if (!h) toast('失敗: ' + msgOf(e)); });
}

/* 予定の中身 */
function selItem() { return SEL ? itemsOn(SEL.date).find(x => x.id === SEL.id) : null; }
function openSheet(date, id) {
  SEL = { date: date, id: id };
  const b = selItem(); if (!b) return;
  const st = toMin(b.time), en = st + (b.dur || 60);
  $('sh-title').textContent = b.member;
  let h = '<div class="row"><span class="sub">時間</span><span>' + dateLabel(date) + ' ' + minStr(st) + '–' + minStr(en) + '（' + (b.dur || 60) + '分）</span></div>';
  if (b.menu) h += '<div class="row"><span class="sub">メニュー</span><span>' + esc(b.menu) + '</span></div>';
  if (b.done) h += '<div class="row"><span class="sub">来店</span><span>✓ 来店済み</span></div>';
  if (b.phone) h += '<div class="row"><span class="sub">電話</span><a href="tel:' + esc(b.phone) + '">' + esc(b.phone) + '</a></div>';
  if (b.src) h += '<div class="row"><span class="sub">受付</span><span>' + esc(b.src === 'Web' ? '予約ページから' : b.src) + '</span></div>';
  if (b.memo) h += '<div class="row"><span class="sub">メモ</span><span style="text-align:right">' + esc(b.memo) + '</span></div>';
  $('sh-body').innerHTML = h;
  $('sh-trainer').value = b.trainer || '';
  $('sh-visit').disabled = !!b.done;
  $('sh-visit').textContent = b.done ? '来店済み' : '来店入力へ';
  showPanel('sheet');
}
function changeTrainer() {
  const b = selItem(); if (!b) return;
  const t = v('sh-trainer'), date = SEL.date;
  srv('setBookingTrainer', [{ id: b.id, trainer: t, date: date }],
    l => { ITEMS[date] = l; renderSched(); closeAll(); toast('担当を「' + (t || '担当未定') + '」にしました'); });
}
function delBooking() {
  const b = selItem(); if (!b) return;
  const date = SEL.date;
  closeAll();
  srv('deleteBooking', [{ id: b.id, date: date }], l => {
    ITEMS[date] = l; renderSched();
    toast(b.time + ' ' + b.member + 'さんの予定を削除しました', {
      action: '元に戻す',
      onAction: () => srv('addBooking', [{ date: date, time: b.time, member: b.member, trainer: b.trainer, memo: b.memo, dur: b.dur, menu: b.menu, phone: b.phone, src: b.src }],
        l2 => { ITEMS[date] = l2; renderSched(); toast('元に戻しました'); })
    });
