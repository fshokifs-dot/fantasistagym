<!DOCTYPE html>
<html lang="ja">
<head>
<base target="_top">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,500;0,600;0,700;1,700&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  /* 色と書体 ─ 赤基調。文字は赤に合う黒、数字はスコアボード風の細長い書体 */
  :root {
    --bg:#F4F1F1; --card:#FFFFFF; --ink:#221C1D; --sub:#716A6B; --line:#E6DFDF; --line2:#F0EBEB;
    --acc:#D3202A; --acc-deep:#A0141C; --acc-soft:#FCE8E9; --red:#D3202A; --red-soft:#FCE8E9;
    --num:'Barlow Condensed', 'Zen Kaku Gothic New', sans-serif;
  }
  * { box-sizing: border-box; }
  body { margin:0; font-family:'Zen Kaku Gothic New', -apple-system, 'Hiragino Sans', sans-serif; background:var(--bg); color:var(--ink); padding-bottom:88px; -webkit-font-smoothing:antialiased; }
  .num { font-family:var(--num); font-variant-numeric:tabular-nums; }
  button, input, select, textarea { font-family:inherit; }
  :focus-visible { outline:2px solid var(--acc); outline-offset:2px; }

  header { display:flex; justify-content:space-between; align-items:center; padding:12px 16px; background:var(--acc); color:#fff; position:sticky; top:0; z-index:5; height:56px; }
  header .ttl { display:flex; align-items:baseline; gap:10px; }
  header .brand { font-family:var(--num); font-style:italic; font-weight:700; font-size:15px; letter-spacing:.06em; color:rgba(255,255,255,.72); }
  header #title { font-size:18px; font-weight:700; }
  header button { font-size:13px; color:rgba(255,255,255,.8); background:none; border:0; padding:6px 2px; }

  .page { display:none; padding:16px; }
  .page.on { display:block; }
  .card { background:var(--card); border-radius:18px; padding:16px; margin-bottom:12px; box-shadow:0 1px 0 var(--line); }
  label { display:block; font-size:13px; font-weight:500; color:var(--sub); margin:12px 0 6px; }
  select, input, textarea { width:100%; font-size:16px; padding:13px 14px; border:1.5px solid var(--line); border-radius:12px; background:#fff; color:var(--ink); appearance:none; -webkit-appearance:none; }
  select { background-image:linear-gradient(45deg,transparent 50%,var(--sub) 50%),linear-gradient(135deg,var(--sub) 50%,transparent 50%); background-position:calc(100% - 20px) 55%,calc(100% - 15px) 55%; background-size:5px 5px; background-repeat:no-repeat; padding-right:36px; }
  select:focus, input:focus, textarea:focus { border-color:var(--acc); outline:none; }
  textarea { min-height:110px; line-height:1.6; }
  button.main { width:100%; margin-top:16px; padding:16px; font-size:16px; font-weight:700; color:#fff; background:var(--acc); border:0; border-radius:14px; box-shadow:0 3px 0 var(--acc-deep); }
  button.main:active { transform:translateY(2px); box-shadow:0 1px 0 var(--acc-deep); }
  button.main:disabled { opacity:.5; }
  .ghost { width:100%; padding:13px; border:1.5px solid var(--line); background:#fff; border-radius:12px; font-size:15px; font-weight:500; color:var(--ink); }

  nav { position:fixed; bottom:0; left:0; right:0; display:flex; background:#fff; border-top:1px solid var(--line); padding-bottom:env(safe-area-inset-bottom); z-index:6; }
  nav button { flex:1; display:flex; flex-direction:column; align-items:center; gap:3px; padding:9px 0 10px; font-size:11px; font-weight:500; background:none; border:0; color:var(--sub); position:relative; }
  nav button svg { width:23px; height:23px; stroke:currentColor; fill:none; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; }
  nav button.on { color:var(--acc); font-weight:700; }
  nav button.on::before { content:""; position:absolute; top:-1px; left:28%; right:28%; height:3px; border-radius:0 0 3px 3px; background:var(--acc); }

  .big { font-family:var(--num); font-size:48px; font-weight:700; line-height:1.05; letter-spacing:.01em; }
  .row { display:flex; justify-content:space-between; align-items:center; gap:8px; padding:10px 0; border-bottom:1px solid var(--line2); font-size:15px; }
  .row:last-child { border-bottom:0; }
  .row b.num { font-size:20px; font-weight:600; }
  .sub { color:var(--sub); font-size:13px; }
  .low { color:var(--red); font-weight:700; }
  .acts { display:flex; gap:8px; margin-top:14px; }
  .acts button { flex:1; padding:13px; font-size:15px; font-weight:700; border-radius:12px; border:0; background:var(--acc); color:#fff; }
  .acts button:disabled { background:var(--line); color:var(--sub); }
  .acts button.del { color:var(--red); background:var(--red-soft); flex:0 0 84px; }
  .daybar { display:flex; gap:8px; align-items:center; }
  .daybar button { width:48px; height:48px; flex:0 0 48px; font-size:15px; border:1.5px solid var(--line); background:#fff; border-radius:12px; color:var(--ink); }
  .daybar input { flex:1; font-family:var(--num); font-size:18px; font-weight:600; }
  .gtitle { margin:18px 4px 8px; font-weight:700; font-size:15px; display:flex; align-items:baseline; gap:8px; }
  .gtitle .sub { font-weight:400; }
  .mcard { display:flex; justify-content:space-between; align-items:center; background:#fff; border-radius:14px; padding:14px 16px; margin-bottom:8px; box-shadow:0 1px 0 var(--line); cursor:pointer; }
  .mcard .left { font-family:var(--num); font-size:18px; font-weight:600; }
  .mcard .left small { font-family:'Zen Kaku Gothic New', sans-serif; font-size:12px; color:var(--sub); font-weight:400; margin-left:2px; }
  .mcard .left.low { color:var(--red); }

  /* 来店入力：種目の行 */
  .exhead { display:flex; justify-content:space-between; align-items:center; margin:20px 0 8px; }
  .exhead b { font-size:15px; }
  .copyprev { border:0; background:var(--acc-soft); color:var(--acc); font-size:13px; font-weight:700; padding:8px 12px; border-radius:10px; }
  .copyprev:disabled { background:var(--bg); color:#CFC3C4; }
  .ex { border:1.5px solid var(--line); border-radius:14px; padding:10px; margin-bottom:8px; background:#FAFBFC; }
  .ex input { padding:11px 12px; background:#fff; }
  .ex-top { display:flex; gap:8px; align-items:center; }
  .ex-top input { flex:1; min-width:0; }
  .ex-no { flex:0 0 26px; height:26px; border-radius:50%; background:var(--ink); color:#fff; display:flex; align-items:center; justify-content:center; font-size:15px; font-weight:700; }
  .ex-del { flex:0 0 38px; height:38px; border:0; border-radius:10px; background:var(--red-soft); color:var(--red); font-size:18px; }
  .ex-grid { display:grid; grid-template-columns:1.25fr 1fr 1fr; gap:6px; margin-top:8px; }
  .ex-grid div { position:relative; }
  .ex-grid input { padding:11px 30px 11px 8px; font-family:var(--num); font-size:20px; font-weight:600; text-align:right; }
  .ex-grid .u-set input { padding-right:40px; }
  .ex-grid .u-rep input { padding-right:22px; }
  .ex-grid span { position:absolute; right:10px; top:50%; transform:translateY(-50%); font-size:11px; color:var(--sub); pointer-events:none; }
  .ex .ex-note { margin-top:6px; font-size:14px; }
  .addrow { width:100%; padding:13px; border:1.5px dashed #DDB9BB; background:none; border-radius:14px; color:var(--acc); font-weight:700; font-size:15px; }
  .stepper { display:flex; gap:8px; align-items:center; }
  .stepper button { flex:0 0 52px; height:52px; border:0; border-radius:12px; background:var(--acc-soft); color:var(--acc); font-size:24px; font-weight:700; }
  .stepper input { flex:1; text-align:center; font-size:28px; font-weight:700; padding:8px; }
  .tagsg { display:inline-block; font-size:11px; font-weight:700; color:var(--acc); background:var(--acc-soft); border-radius:6px; padding:1px 7px; margin-left:6px; vertical-align:2px; }
  .amt-g { margin-top:14px; }
  .amt-h { display:flex; align-items:baseline; gap:8px; padding-bottom:6px; border-bottom:2px solid var(--ink); }
  .amt-h b { font-family:var(--num); font-size:24px; font-weight:700; }
  .amt-h .sub { margin-left:auto; }
  /* 来店の記録カード */
  .vcard { background:#fff; border-radius:16px; padding:14px 16px; margin-bottom:10px; box-shadow:0 1px 0 var(--line); }
  .vhead { display:flex; align-items:baseline; gap:10px; }
  .vhead .vdate { font-size:19px; font-weight:600; }
  .vhead .sub { margin-left:auto; }
  .vt { width:100%; border-collapse:collapse; margin-top:8px; font-size:14px; }
  .vt th { font-size:11px; font-weight:500; color:var(--sub); text-align:right; padding:4px; border-bottom:1px solid var(--line); }
  .vt td { padding:7px 4px; border-bottom:1px solid var(--line2); text-align:right; vertical-align:top; }
  .vt th:first-child, .vt td:first-child { text-align:left; padding-left:0; }
  .vt td.num { font-size:17px; font-weight:600; white-space:nowrap; }
  .vt tr:last-child td { border-bottom:0; }
  .vnote { font-size:12px; color:var(--sub); margin-top:2px; }
  .editbar { background:var(--acc); color:#fff; border-radius:14px; padding:12px 16px; margin-bottom:12px; font-size:14px; font-weight:500; }
  .editbar b { font-weight:700; }
  .vmemo { margin-top:8px; padding:9px 11px; background:var(--bg); border-radius:10px; font-size:13px; line-height:1.6; white-space:pre-wrap; }

  /* 予定：切り替えと見出し */
  .ctl { display:flex; gap:8px; align-items:center; margin-bottom:10px; }
  .seg { flex:1; display:flex; background:#E6DEDE; border-radius:12px; padding:3px; }
  .seg button { flex:1; border:0; background:none; padding:10px 0; font-size:15px; font-weight:500; border-radius:10px; color:var(--sub); }
  .seg button.on { background:#fff; color:var(--ink); font-weight:700; box-shadow:0 1px 2px rgba(34,28,29,.14); }
  .ctl .today { padding:12px 18px; border:1.5px solid var(--line); background:#fff; border-radius:12px; font-size:14px; font-weight:700; color:var(--acc); }
  .rng { font-family:var(--num); font-size:30px; font-weight:700; margin:16px 2px 2px; letter-spacing:.01em; }
  .legend { display:flex; flex-wrap:wrap; gap:6px 12px; margin:8px 2px 0; font-size:12px; color:var(--sub); }
  .legend i { display:inline-block; width:10px; height:10px; border-radius:3px; margin-right:4px; vertical-align:-1px; }

  /* 予定のブロック（日・週 共通） */
  .blk { position:absolute; border-radius:7px; padding:3px 6px; font-size:12px; line-height:1.3; overflow:hidden; color:#fff; cursor:pointer; box-shadow:0 0 0 1.5px #fff; z-index:1; }
  .blk b { font-size:13px; font-weight:700; }
  .blk .t { font-family:var(--num); font-size:13px; font-weight:600; }
  .blk.done { opacity:.42; }
  .blk .tag { display:inline-block; font-size:10px; padding:0 5px; border-radius:4px; background:rgba(255,255,255,.28); margin-left:4px; vertical-align:1px; }
  /* 空いている枠の「＋」 */
  .slot { position:absolute; left:0; right:0; display:flex; align-items:center; justify-content:center; color:#D7C6C7; font-size:18px; font-weight:300; pointer-events:none; }

  /* 日の表示 */
  .tl { position:relative; margin:16px 0 16px 52px; border-left:1.5px solid var(--line); cursor:pointer; -webkit-tap-highlight-color:transparent; background:#fff; border-radius:0 12px 12px 0; }
  .tl .line { position:absolute; left:0; right:0; border-top:1px solid var(--line2); }
  .tl .half { position:absolute; left:0; right:0; border-top:1px dashed var(--line2); }
  .tl .hr { position:absolute; left:-52px; width:44px; text-align:right; font-family:var(--num); font-size:15px; font-weight:600; color:var(--ink); transform:translateY(-9px); line-height:1.1; }
  .tl .hr .cnt { font-size:12px; font-weight:500; color:var(--sub); }
  .tl .hr .full { color:var(--red); font-weight:700; }
  .tl .fullbg { position:absolute; left:0; right:0; background:var(--red-soft); }
  .tl .slot { justify-content:flex-end; padding-right:14px; font-size:13px; font-weight:500; }

  /* 週の表示 */
  .wk { margin:12px -16px 16px; background:#fff; border-top:1px solid var(--line); border-bottom:1px solid var(--line); }
  .wk-head { display:flex; position:sticky; top:56px; z-index:3; background:#fff; border-bottom:1px solid var(--line); }
  .wk-gut { flex:0 0 40px; }
  .wd { flex:1; min-width:0; text-align:center; padding:6px 0 8px; cursor:pointer; }
  .wd span { display:block; font-size:11px; font-weight:500; color:var(--sub); }
  .wd b { display:inline-block; font-family:var(--num); font-size:22px; font-weight:600; width:36px; height:36px; line-height:36px; border-radius:50%; }
  .wd.sat span { color:#2F6FD6; } .wd.sun span { color:var(--acc); }
  .wd.today b { background:var(--acc); color:#fff; font-weight:700; }
  .wk-body { position:relative; margin-left:40px; border-left:1px solid var(--line); }
  .wk-hr { position:absolute; left:-40px; width:34px; text-align:right; font-family:var(--num); font-size:13px; font-weight:600; color:var(--sub); transform:translateY(-8px); }
  .wk-line { position:absolute; left:0; right:0; border-top:1px solid var(--line2); }
  .wk-cols { position:absolute; top:0; bottom:0; left:0; right:0; cursor:pointer; -webkit-tap-highlight-color:transparent; }
  .wk-col { position:absolute; top:0; bottom:0; border-right:1px solid var(--line2); }
  .wk-col .fullbg { position:absolute; left:0; right:0; background:repeating-linear-gradient(135deg,#FBE3E4,#FBE3E4 5px,#F7D3D5 5px,#F7D3D5 10px); }
  .wk .blk { padding:2px 3px; font-size:10px; line-height:1.25; word-break:break-all; border-radius:5px; }
  .wk .blk b { font-size:11px; }
  .wk .blk.v { padding:3px 0; text-align:center; line-height:1.15; }
  .wk .blk.v b { font-size:11px; }

  /* 下から出るパネル */
  #dim { display:none; position:fixed; inset:0; background:rgba(34,28,29,.38); z-index:7; }
  .bsheet { display:none; position:fixed; left:0; right:0; bottom:0; max-height:88vh; overflow:auto; background:#fff; border-radius:22px 22px 0 0; padding:10px 18px calc(18px + env(safe-area-inset-bottom)); z-index:8; box-shadow:0 -10px 30px rgba(34,28,29,.18); animation:up .22s ease-out; }
  .bsheet::before { content:""; display:block; width:40px; height:4px; border-radius:2px; background:var(--line); margin:0 auto 12px; }
  @keyframes up { from { transform:translateY(24px); opacity:.6; } to { transform:none; opacity:1; } }
  @media (prefers-reduced-motion: reduce) { .bsheet { animation:none; } }
  .bhead { display:flex; justify-content:space-between; align-items:center; gap:8px; }
  .bhead b { font-size:19px; }
  .bhead button { border:0; background:var(--bg); border-radius:50%; width:36px; height:36px; font-size:18px; color:var(--sub); flex:0 0 36px; }
  .two { display:flex; gap:8px; } .two > div { flex:1; min-width:0; }
  .pk-list { max-height:36vh; overflow:auto; margin-top:8px; border:1.5px solid var(--line); border-radius:14px; }
  .pk-item { display:flex; justify-content:space-between; align-items:center; gap:8px; width:100%; padding:14px; border:0; border-bottom:1px solid var(--line2); background:#fff; font-size:16px; text-align:left; color:var(--ink); }
  .pk-item:last-child { border-bottom:0; }
  .pk-item:active { background:var(--acc-soft); }
  .pk-item .sub { flex:0 0 auto; }
  .pk-new { display:flex; gap:8px; margin-top:10px; }
  .pk-new button { flex:0 0 80px; border:0; background:var(--acc-soft); color:var(--acc); font-weight:700; border-radius:12px; font-size:15px; }
  .capline { margin-top:10px; font-size:13px; padding:8px 12px; border-radius:10px; background:var(--bg); color:var(--sub); }
  .capline:empty { display:none; }
  .capline.full { color:var(--red); background:var(--red-soft); font-weight:700; }

  #login { display:none; position:fixed; inset:0; background:var(--acc); z-index:20; padding:72px 20px; overflow:auto; }
  #login .brandbig { font-family:var(--num); font-style:italic; font-weight:700; font-size:44px; line-height:1; color:#fff; letter-spacing:.02em; margin-bottom:6px; }
  #login .lead { color:rgba(255,255,255,.82); font-size:14px; margin-bottom:24px; }
  /* ---------- 仕上げ：動き・メニュー・トースト・引っぱって更新・スワイプ・グラフ ---------- */
  html, body { overscroll-behavior-y:contain; }
  /* 画面の切り替え */
  .page.on { animation:pageIn .28s cubic-bezier(.2,.8,.2,1); }
  @keyframes pageIn { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:none; } }
  /* 押した感触 */
  button { transition:transform .12s ease, box-shadow .12s ease, background-color .2s ease; -webkit-tap-highlight-color:transparent; }
  button:active:not(:disabled) { transform:scale(.96); }
  .mcard, .blk { transition:transform .12s ease, filter .12s ease; }
  .mcard:active, .blk:active { transform:scale(.98); filter:brightness(.95); }
  /* 下から出るパネルの背景 */
  #dim { transition:opacity .2s; }

  /* ヘッダー：ハンバーガーと更新 */
  header .ttl { flex:1; min-width:0; }
  .hbtn { width:40px; height:40px; flex:0 0 40px; border:0; border-radius:12px; background:rgba(255,255,255,.14); display:flex; align-items:center; justify-content:center; padding:0; }
  .hbtn svg { width:22px; height:22px; stroke:#fff; fill:none; stroke-width:2; stroke-linecap:round; }
  .hamb { margin-right:12px; flex-direction:column; gap:4px; }
  .hamb i { display:block; width:18px; height:2px; border-radius:2px; background:#fff; transition:transform .25s, opacity .2s; }
  body.drawer-open .hamb i:nth-child(1) { transform:translateY(6px) rotate(45deg); }
  body.drawer-open .hamb i:nth-child(2) { opacity:0; }
  body.drawer-open .hamb i:nth-child(3) { transform:translateY(-6px) rotate(-45deg); }
  .hbtn.spin svg { animation:spin .8s linear infinite; }
  @keyframes spin { to { transform:rotate(360deg); } }

  /* 横から出るメニュー */
  #ddim { position:fixed; inset:0; background:rgba(34,28,29,.42); z-index:11; opacity:0; pointer-events:none; transition:opacity .25s; }
  body.drawer-open #ddim { opacity:1; pointer-events:auto; }
  #drawer { position:fixed; top:0; bottom:0; left:0; width:min(84vw,320px); background:#fff; z-index:12; transform:translateX(-104%); transition:transform .3s cubic-bezier(.2,.8,.2,1); display:flex; flex-direction:column; box-shadow:8px 0 30px rgba(34,28,29,.2); }
  body.drawer-open #drawer { transform:none; }
  .dr-head { background:var(--acc); color:#fff; padding:28px 20px 20px; }
  .dr-head .b { font-family:var(--num); font-style:italic; font-weight:700; font-size:26px; line-height:1; }
  .dr-head .s { font-size:13px; opacity:.82; margin-top:6px; }
  .dr-body { flex:1; overflow:auto; padding:10px 10px calc(16px + env(safe-area-inset-bottom)); }
  .dr-item { display:flex; align-items:center; gap:14px; width:100%; padding:13px 12px; border:0; background:none; border-radius:12px; font-size:16px; font-weight:500; color:var(--ink); text-align:left; }
  .dr-item svg { width:22px; height:22px; stroke:var(--sub); fill:none; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; flex:0 0 22px; }
  .dr-item.on { background:var(--acc-soft); color:var(--acc); font-weight:700; }
  .dr-item.on svg { stroke:var(--acc); }
  .dr-sep { height:1px; background:var(--line); margin:10px 12px; }
  .dr-cap { font-size:12px; color:var(--sub); padding:6px 12px 2px; }
  .dr-url { margin:6px 12px 2px; font-size:12px; padding:10px; background:var(--bg); border:0; border-radius:10px; color:var(--sub); }
  .dr-item.out { color:var(--acc); }
  .dr-item.out svg { stroke:var(--acc); }

  /* トースト */
  #toast { position:fixed; left:16px; right:16px; bottom:96px; margin:0 auto; max-width:440px; display:flex; align-items:center; gap:10px; background:var(--ink); color:#fff; padding:11px 12px 11px 14px; border-radius:16px; font-size:14px; z-index:30; box-shadow:0 10px 26px rgba(34,28,29,.28);
    opacity:0; pointer-events:none; transform:translateY(16px) scale(.98); transition:opacity .22s, transform .3s cubic-bezier(.2,.9,.25,1.2); }
  #toast.show { opacity:1; pointer-events:auto; transform:none; }
  #toast .ic { flex:0 0 24px; height:24px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:14px; font-weight:700; background:#2E9E5B; }
  #toast.err .ic { background:var(--acc); }
  #toast .tx { flex:1; line-height:1.45; }
  #toast .act { flex:0 0 auto; border:0; background:rgba(255,255,255,.16); color:#fff; font-weight:700; font-size:13px; padding:8px 12px; border-radius:10px; }
  #toast .act:empty { display:none; }

  /* 引っぱって更新 */
  #ptr { position:fixed; top:64px; left:50%; width:42px; height:42px; margin-left:-21px; border-radius:50%; background:#fff; box-shadow:0 4px 14px rgba(34,28,29,.2); display:flex; align-items:center; justify-content:center; z-index:4; transform:translateY(-90px); opacity:0; pointer-events:none; }
  #ptr svg { width:22px; height:22px; stroke:var(--acc); fill:none; stroke-width:2.2; stroke-linecap:round; }
  #ptr.back { transition:transform .25s, opacity .25s; }
