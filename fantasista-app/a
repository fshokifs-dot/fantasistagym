}
function startVisit() {
  const b = selItem(); if (!b || b.done) return;
  closeAll();
  $('v-date').value = SEL.date.replace(/\//g, '-');
  const isMember = !!(D && D.members.some(m => m.name === b.member));
  $('v-member').value = isMember ? b.member : '__single';
  $('v-single').value = isMember ? '' : b.member;
  $('v-trainer').value = b.trainer || '';
  resetVisitForm();
  memberPicked();
  PENDING = b.id;
  go('visit', $('nav-visit'));
  if (!isMember) toast('会員一覧にいない方なので、単発で記録します');
  else if (!b.trainer) toast('担当を選んでね');
}

function copyUrl() {
  const el = $('bookurl'); el.select(); el.setSelectionRange(0, 9999);
  let ok = false;
  try { ok = document.execCommand('copy'); } catch (e) {}
