const SW_W = 76;
function swipeWrap(front, acts, small) {
  return '<div class="sw' + (small ? ' m' : '') + '"><div class="sw-acts">' + acts.map(a =>
    '<button class="' + a.cls + '" onclick="' + a.on + '"><svg viewBox="0 0 24 24">' + a.icon + '</svg>' + a.label + '</button>').join('') +
