(function pullToRefresh() {
  let y0 = null, x0 = 0, dist = 0, active = false;
  const ptr = () => $('ptr');
  const panelOpen = () => document.body.classList.contains('drawer-open') || $('dim').style.display === 'block' || $('login').style.display === 'block';
  const put = (d) => {
    const p = ptr();
    p.classList.remove('back');
    p.style.opacity = String(Math.min(1, d / 40));
    p.style.transform = 'translateY(' + (d - 90) + 'px) rotate(' + (d * 4) + 'deg)';
    p.classList[d >= 64 ? 'add' : 'remove']('ready');
  };
  const reset = () => {
    const p = ptr();
    p.classList.add('back');
    p.classList.remove('ready', 'loading');
    p.style.opacity = '0';
    p.style.transform = 'translateY(-90px)';
  };
  document.addEventListener('touchstart', e => {
    if ((window.scrollY || document.documentElement.scrollTop) > 0 || panelOpen() || REFRESHING) { y0 = null; return; }
    y0 = e.touches[0].clientY; x0 = e.touches[0].clientX; dist = 0; active = false;
  }, { passive: true });
  document.addEventListener('touchmove', e => {
    if (y0 == null) return;
    const dy = e.touches[0].clientY - y0, dx = Math.abs(e.touches[0].clientX - x0);
    if (!active && (dy < 8 || dx > dy)) { if (dx > 12) y0 = null; return; }
    active = true;
    dist = Math.min(dy * 0.5, 96);
    put(dist);
  }, { passive: true });
  document.addEventListener('touchend', () => {
    if (y0 == null || !active) { y0 = null; return; }
    y0 = null;
    if (dist >= 64) {
      const p = ptr();
      p.classList.add('back', 'loading');
      p.style.transform = 'translateY(0)';
      refreshAll(reset);
    } else reset();
  });
})();

