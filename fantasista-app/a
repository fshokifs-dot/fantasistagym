}

/* ---------- 売上 ---------- */
let SALESPIN = '';
function showSales(on) {
  $('s-lock').style.display = on ? 'none' : 'block';
  $('s-body').style.display = on ? 'block' : 'none';
}
function unlockSales() {
  const pin = v('s-pin');
  if (!pin) return;
  fetchSales(pin);
}
function lockSales() { SALESPIN = ''; showSales(false); $('s-msg').textContent = ''; }
function fetchSales(pin) {
  const b = $('s-btn'); b.disabled = true;
  srv('getSalesView', [pin], r => {
    b.disabled = false;
    if (r.error) {
      SALESPIN = ''; showSales(false);
      $('s-msg').textContent =
        r.error === 'wrong' ? '暗証番号が違います' :
        r.error === 'locked' ? '間違いが続いたので、10分ほどロックされています' :
        'スプレッドシートの「設定」シートで、売上の暗証番号を入れてください';
      return;
    }
    SALESPIN = pin;
    $('s-pin').value = '';
    $('s-msg').textContent = '';
    renderSales(r.sales);
    showSales(true);
  }, (e, h) => { b.disabled = false; if (!h) toast('失敗: ' + msgOf(e)); });
}
function lastMonths(cur, n) {
  const p = cur.split('/'); let y = +p[0], m = +p[1];
  const out = [];
  for (let i = 0; i < n; i++) { out.unshift(y + '/' + pad2(m)); m--; if (!m) { m = 12; y--; } }
  return out;
}
function barTip(i) {
  document.querySelectorAll('#s-bars .bar').forEach((b, j) => b.classList[j === i ? 'toggle' : 'remove']('tip'));
}
function renderSales(s) {
  $('s-month').textContent = s.month;
  countUp($('s-this'), s.thisMonth, yen);
  // 月別の棒グラフ（直近6か月）。今月だけ濃い赤＋金額、ほかは押すと金額
  const months = lastMonths(s.month, 6);
  const vals = months.map(m => s.byMonth[m] || 0);
  const max = Math.max.apply(null, vals.concat([1]));
  const prev = vals[vals.length - 2];
  $('s-diff').textContent = prev ? '先月 ' + yen(prev) + '（' + (s.thisMonth >= prev ? '+' : '−') + yen(Math.abs(s.thisMonth - prev)).replace('¥', '¥') + '）' : '';
  $('s-bars').innerHTML = months.map((m, i) => {
    const cur = i === months.length - 1;
    return '<div class="bar' + (cur ? ' cur' : '') + '" onclick="barTip(' + i + ')" role="img" aria-label="' + (+m.split('/')[1]) + '月 ' + yen(vals[i]) + '">' +
      '<span class="val" style="bottom:' + (vals[i] / max * 100) + '%">' + yen(vals[i]) + '</span>' +
      '<i style="height:' + Math.max(1, vals[i] / max * 100) + '%"></i></div>';
  }).join('');
  $('s-barsx').innerHTML = months.map((m, i) => '<span' + (i === months.length - 1 ? ' class="cur"' : '') + '>' + (+m.split('/')[1]) + '月</span>').join('');
  // コース別：横棒（いちばん多いコースを100%）
  const courseRows = (obj, empty) => {
    const keys = Object.keys(obj).sort((a, b) => obj[b] - obj[a]);
    const top = keys.length ? obj[keys[0]] || 1 : 1;
    return keys.map(k => '<div class="hb"><div class="hb-top"><span>' + esc(k) + '</span><b>' + yen(obj[k]) + '</b></div>' +
      '<div class="hb-track"><i style="width:' + Math.max(2, obj[k] / top * 100) + '%"></i></div></div>').join('') || '<div class="sub" style="margin-top:8px">' + empty + '</div>';
  };
  $('s-cm').innerHTML = courseRows(s.byCourseMonth || {}, '今月の入金はまだありません');
  $('s-amt').innerHTML = (s.byAmount || []).map(g =>
    '<div class="amt-g"><div class="amt-h"><b>' + (g.amount == null ? '入金なし' : yen(g.amount)) + '</b><span class="sub">' + g.members.length + '人</span></div>' +
    g.members.map(m => '<div class="row"><span>' + esc(m.name) + ' <span class="sub">' + esc(m.course) + '</span></span><b class="num">' + (m.total ? yen(m.total) : '—') + '</b></div>').join('') +
    '</div>').join('') || '<div class="sub" style="margin-top:8px">会員がまだいません</div>';
  $('s-ca').innerHTML = courseRows(s.byCourseAll || {}, 'まだ入金がありません');
  $('s-mo').innerHTML = Object.keys(s.byMonth).sort().reverse().map(k =>
    '<div class="row"><span class="num" style="font-size:17px">' + esc(k) + '</span><b class="num">' + yen(s.byMonth[k]) + '</b></div>').join('');
}

/* ---------- 会員の履歴 ---------- */
let CURM = '';
function openHistory(i) {
  const m = D.members[i];
  document.querySelectorAll('.page').forEach(p => p.classList.remove('on'));
  $('p-hist').classList.add('on');
  $('title').textContent = '会員の記録';
  $('h-name').textContent = m.name;
  CURM = m.name;
  $('h-sub').textContent = (m.plan || NOCOURSE) + ' / 残り ' + m.left + '回';
  $('h-plan').value = m.plan || '';
  $('h-left').value = m.left;
  $('h-list').innerHTML = '<div class="sub">読み込み中…</div>';
  srv('getHistory', [m.name], list => {
    $('h-list').innerHTML = list.map(x => visitCard(x, false)).join('') || '<div class="sub">まだ記録がありません</div>';
  });
}
function stepLeft(n) { $('h-left').value = Math.max(0, (Number(v('h-left')) || 0) + n); }
function saveMember() {
  if (!CURM) return;
  const left = Number(v('h-left'));
  if (!isFinite(left) || left < 0) return toast('残り回数は0以上の数で入れてね');
  const b = $('h-save'); b.disabled = true;
  srv('updateMember', [{ name: CURM, plan: v('h-plan'), left: left }], d => {
    b.disabled = false;
    render(d);
    const m = d.members.find(x => x.name === CURM);
    if (m) $('h-sub').textContent = (m.plan || NOCOURSE) + ' / 残り ' + m.left + '回';
    toast('会員情報を保存しました');
  }, (e, h) => { b.disabled = false; if (!h) toast('失敗: ' + msgOf(e)); });
}
function reloadHistory() {
  if (!CURM) return;
  srv('getHistory', [CURM], list => {
    $('h-list').innerHTML = list.map(x => visitCard(x, false)).join('') || '<div class="sub">まだ記録がありません</div>';
  });
}
function deleteMember() {
  if (!CURM) return;
  if (!confirm('「' + CURM + '」さんを会員から削除します。\n来店記録・入金の履歴は残ります。よろしいですか？')) return;
  srv('deleteMember', [CURM], d => { render(d); closeHistory(); toast('削除しました'); });
}
function closeHistory() {
  $('p-hist').classList.remove('on');
  $('p-mem').classList.add('on');
  $('title').textContent = '会員';
}

/* ---------- 起動 ---------- */
if (KEY) boot();
else BR.ask('get', '', (val, got) => { if (got && val) { KEY = val; boot(); } else showLogin(''); });
</script>
</body>
