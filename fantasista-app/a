<script>
let D = null, KEY = '', CAP = 3, OPEN = 9, CLOSE = 22;
try { KEY = localStorage.getItem('staffKey') || ''; } catch (e) {}
/* ---------- 合言葉の預け先（ホーム画面のアプリは、中のページのメモが消えやすいので、入り口のページにも預ける） ---------- */
const BR = (() => {
  let framed = true; try { framed = window.top !== window; } catch (e) {}
  let seq = 0; const waits = {};
  window.addEventListener('message', ev => {
    const d = ev.data;
    if (!d || d.fs !== 1) return;
    try { if (ev.source !== window.top) return; } catch (e) { return; }
    const w = waits[d.id]; if (w) { delete waits[d.id]; w(d.v); }
  });
  function ask(op, v, cb) {
    cb = cb || function () {};
    if (!framed) { cb('', false); return; }
    const id = ++seq; let done = false;
    const fin = (val, got) => { if (done) return; done = true; delete waits[id]; cb(val, got); };
    waits[id] = val => fin(val, true);
    setTimeout(() => fin('', false), 1500);
    try { window.top.postMessage({ fs: 1, id: id, op: op, k: 'staffKey', v: v }, '*'); } catch (e) { fin('', false); }
  }
  return { ask: ask };
})();
const TITLES = { visit:'来店入力', sched:'予定', pay:'入金', sales:'売上', mem:'会員' };
const yen = n => '¥' + Number(n).toLocaleString();
const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const $ = id => document.getElementById(id);
function v(id) { return String($(id).value == null ? "" : $(id).value).trim(); }

/* ---------- サーバー呼び出し（合言葉を自動でつける） ---------- */
function msgOf(e) { return String((e && e.message) || e || ''); }
function authErr(e) {
  const m = msgOf(e);
  if (m.indexOf('BADKEY') >= 0) { showLogin('合言葉が違います'); return true; }
  if (m.indexOf('NOSTAFFKEY') >= 0) { showLogin('スプレッドシートの「設定」シートで「スタッフ用の合言葉」を決めて入れてください'); return true; }
  if (m.indexOf('LOCKED') >= 0) { showLogin('合言葉の間違いが続いたので、10分ほど待ってからやり直してください'); return true; }
  return false;
}
function srv(fn, args, ok, fail) {
  const r = google.script.run
    .withSuccessHandler(ok)
    .withFailureHandler(e => { const h = authErr(e); if (fail) fail(e, h); else if (!h) toast('失敗: ' + msgOf(e)); });
  r[fn].apply(r, [KEY].concat(args || []));
}

/* ---------- ログイン ---------- */
function showLogin(msg) {
  $('login').style.display = 'block';
  $('lg-msg').textContent = msg || '';
  $('lg-btn').disabled = false;
}
function login() {
  const k = v('lg-key');
  if (!k) return;
  KEY = k;
  $('lg-btn').disabled = true;
  boot();
}
function boot() {
  srv('getInit', [], d => {
    try { localStorage.setItem('staffKey', KEY); } catch (e) {}
    BR.ask('set', KEY);
    $('login').style.display = 'none';
    $('lg-key').value = '';
    render(d);
    loadSched();
  }, (e, handled) => { if (!handled) showLogin('読み込みに失敗しました: ' + msgOf(e)); });
}
function logout() {
  try { localStorage.removeItem('staffKey'); } catch (e) {}
  BR.ask('del', '');
  KEY = '';
  showLogin('ログアウトしました');
}

/* ---------- 画面の切り替え ---------- */
function go(name, btn) {
  closeAll();
  closeDrawer();
  if (SW_OPEN) swClose(SW_OPEN);
  window.scrollTo(0, 0);
  document.querySelectorAll('.page').forEach(p => p.classList.remove('on'));
  $('p-' + name).classList.add('on');
  document.querySelectorAll('nav button').forEach(b => b.classList.remove('on'));
  btn.classList.add('on');
  $('title').textContent = TITLES[name];
  if (name === 'sched') loadSched();
  if (name === 'sales' && SALESPIN) fetchSales(SALESPIN);
}
/* トースト：成功は✓、失敗は！。opt.action と opt.onAction で「元に戻す」などのボタン */
let TOAST_FN = null;
function toast(t, opt) {
  opt = opt || {};
  const e = $('toast');
  const err = opt.type === 'err' || /^失敗|できません|違います/.test(String(t));
  e.className = err ? 'err' : '';
  e.querySelector('.ic').textContent = err ? '!' : '✓';
  e.querySelector('.tx').textContent = t;
  const a = e.querySelector('.act');
  a.textContent = opt.action || '';
  TOAST_FN = opt.onAction || null;
  a.onclick = () => { const f = TOAST_FN; hideToast(); if (f) f(); };
  e.offsetWidth; // 出し直しのアニメーション用
  e.classList.add('show');
  clearTimeout(toast.t);
